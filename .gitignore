# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.coverage
htmlcov/

# CodeAtlas internal state
# EN: state.db and detail/ are regenerable artifacts (ignored); history/ is the
# durable record and is kept in git by design (.codeatlas/.gitignore mirrors this).
# ZH: state.db 与 detail/ 是可再生派生物（忽略）；history/ 是持久记录，
# 按设计入库（.codeatlas/.gitignore 与此一致）。
.codeatlas/*
!.codeatlas/history/
!.codeatlas/.gitignore

# Editors
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store
